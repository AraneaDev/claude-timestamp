{
  "keys": {
    "ENABLED": {
      "default": "on",
      "validator": "ct_is_onoff",
      "values": ["on", "off"],
      "describes": "master switch; off silences every hook without uninstalling the plugin"
    },
    "TZ": {
      "default": "",
      "validator": "ct_is_valid_tz",
      "type": "timezone",
      "describes": "IANA timezone name such as Europe/Amsterdam, or empty for the machine's local time"
    },
    "DISPLAY_FORMAT": {
      "default": "24h",
      "validator": "ct_is_valid_format",
      "values": [
        "24h",
        "short",
        "12h",
        "iso"
      ],
      "type": "format",
      "describes": "clock format of the marker; anything containing a % is a strftime string"
    },
    "CONTEXT_FORMAT": {
      "default": "24h",
      "validator": "ct_is_valid_format",
      "values": [
        "24h",
        "short",
        "12h",
        "iso"
      ],
      "type": "format",
      "describes": "clock format of the time Claude is told"
    },
    "COLOR": {
      "default": "dim",
      "validator": "ct_is_valid_color",
      "values": [
        "none",
        "dim",
        "gray",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan"
      ],
      "describes": "colour of the marker; NO_COLOR disables colour regardless"
    },
    "MARKER": {
      "default": "[{%date }%time{ %elapsed}{ · %tool}]",
      "validator": "ct_is_valid_marker",
      "type": "template",
      "describes": "the marker's layout; %time %elapsed %tool %date are the parts, a {...} group disappears when every part inside it is empty, and groups do not nest"
    },
    "TIME_COLOR": {
      "default": "",
      "validator": "ct_is_valid_part_color",
      "values": [
        "",
        "none",
        "dim",
        "gray",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan"
      ],
      "describes": "colour of %time and %date; empty inherits COLOR"
    },
    "ELAPSED_COLOR": {
      "default": "",
      "validator": "ct_is_valid_part_color",
      "values": [
        "",
        "none",
        "dim",
        "gray",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan"
      ],
      "describes": "colour of %elapsed; SLOW_COLOR still wins once a turn crosses SLOW_AFTER"
    },
    "TOOL_COLOR": {
      "default": "",
      "validator": "ct_is_valid_part_color",
      "values": [
        "",
        "none",
        "dim",
        "gray",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan"
      ],
      "describes": "colour of %tool; empty inherits COLOR"
    },
    "ELAPSED": {
      "default": "on",
      "validator": "ct_is_onoff",
      "values": [
        "on",
        "off"
      ],
      "describes": "show how long the turn took"
    },
    "SLOW_AFTER": {
      "default": "60",
      "validator": "ct_is_seconds",
      "type": "seconds",
      "zero": "disables",
      "describes": "colour the duration once a turn takes at least this many seconds"
    },
    "SLOW_COLOR": {
      "default": "yellow",
      "validator": "ct_is_valid_color",
      "values": [
        "none",
        "dim",
        "gray",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan"
      ],
      "describes": "colour used for the duration of a slow turn"
    },
    "IDLE_AFTER": {
      "default": "3600",
      "validator": "ct_is_seconds",
      "type": "seconds",
      "zero": "disables",
      "describes": "mark a gap of at least this many seconds between messages"
    },
    "DATE_ROLLOVER": {
      "default": "on",
      "validator": "ct_is_onoff",
      "values": [
        "on",
        "off"
      ],
      "describes": "show the date on the first message after the session crosses midnight"
    },
    "SUMMARY": {
      "default": "on",
      "validator": "ct_is_onoff",
      "values": [
        "on",
        "off"
      ],
      "describes": "report session totals on exit"
    },
    "SUBAGENTS": {
      "default": "on",
      "validator": "ct_is_onoff",
      "values": [
        "on",
        "off"
      ],
      "describes": "stamp messages from subagents as well as the main conversation"
    },
    "TOOL_TIMING": {
      "default": "off",
      "validator": "ct_is_onoff",
      "values": [
        "on",
        "off"
      ],
      "describes": "record what each tool call cost; the only setting that costs anything per tool call rather than per message"
    },
    "HISTORY": {
      "default": "on",
      "validator": "ct_is_onoff",
      "values": [
        "on",
        "off"
      ],
      "describes": "record each finished session; timings only, no message text, no paths"
    },
    "HISTORY_LIMIT": {
      "default": "200",
      "validator": "ct_is_history_limit",
      "type": "count",
      "minimum": 1,
      "describes": "how many recorded sessions to keep; 1 or more, and HISTORY=off is how you keep none"
    },
    "INJECT_CONTEXT": {
      "default": "true",
      "validator": "ct_is_bool",
      "values": [
        "true",
        "false"
      ],
      "describes": "tell Claude the local time each prompt was sent"
    }
  },
  "preview_context": {
    "time": "13:22:13",
    "elapsed": "+2m14s",
    "tool": "Bash 1m58s",
    "date": ""
  },
  "markers": {
    "classic": {
      "set": "[{%date }%time{ %elapsed}{ · %tool}]",
      "renders": "[13:22:13 +2m14s · Bash 1m58s]",
      "describes": "the time, the duration, and what made it slow"
    },
    "quiet": {
      "set": "%time",
      "renders": "13:22:13",
      "describes": "just the clock, no brackets"
    },
    "trailing": {
      "set": "%time{ %elapsed}",
      "renders": "13:22:13 +2m14s",
      "describes": "no brackets, the duration when there is one"
    },
    "arrow": {
      "set": "{%date }%time{ → %elapsed}",
      "renders": "13:22:13 → +2m14s",
      "describes": "an arrow instead of brackets"
    }
  },
  "presets": {
    "quieter": {
      "describes": "just the time, nothing else",
      "set": { "ENABLED": "on", "DISPLAY_FORMAT": "short", "ELAPSED": "off", "SLOW_AFTER": "60", "TOOL_TIMING": "off" }
    },
    "default": {
      "describes": "the time and how long the turn took",
      "set": { "ENABLED": "on", "DISPLAY_FORMAT": "24h", "ELAPSED": "on", "SLOW_AFTER": "60", "TOOL_TIMING": "off" }
    },
    "detailed": {
      "describes": "adds which tool made a slow turn slow",
      "set": { "ENABLED": "on", "DISPLAY_FORMAT": "24h", "ELAPSED": "on", "SLOW_AFTER": "30", "TOOL_TIMING": "on" }
    },
    "off": {
      "describes": "no marker at all, without uninstalling",
      "set": { "ENABLED": "off" }
    }
  }
}
