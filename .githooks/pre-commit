#!/usr/bin/env bash
# Refuse commits made directly on an integration branch.
#
# Work belongs on a topic branch so it can be reviewed as a pull request.
# Committing to main locally is easy to do by accident and awkward to undo once
# anything is built on top of it.
#
# Install by copying into .git/hooks/ rather than pointing core.hooksPath at
# this directory: a tracked hook only exists in the working tree while a branch
# containing it is checked out, so it would be missing on exactly the branches
# that predate it.
#
# Deliberate exception (a release chore, an emergency fix):
#     git commit --no-verify
set -eu

PROTECTED='main master'

# Empty during a rebase, cherry-pick, or any other detached-HEAD operation,
# which must not be blocked: those commits were already made on a branch.
branch="$(git symbolic-ref --quiet --short HEAD || true)"
[ -n "$branch" ] || exit 0

for protected in $PROTECTED; do
  if [ "$branch" = "$protected" ]; then
    cat >&2 <<MSG

  Refusing to commit directly on '$branch'.

    git switch -c some-branch-name
    git commit ...

  If you really meant it: git commit --no-verify

MSG
    exit 1
  fi
done

# Staged shell scripts get the checks CI runs, on the staged content rather
# than the working tree, so a partial `git add -p` cannot pass here and fail
# there. The shellcheck half is skipped when shellcheck is absent: this is a
# guard rail, not a control, and it must not block a contributor who has not
# installed it.
#
# ACMR rather than ACM. Git reports a file that is renamed and edited in one
# stage as R, so omitting it would let a rename carry a broken script straight
# past this check. --name-only already resolves a rename to its new path.
staged="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.sh$|^\.githooks/' || true)"
if [ -n "$staged" ]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  rc=0
  # `read`, not `for f in $staged`: a filename carrying a space would split
  # into tokens that are not files, and every failed lookup below would then
  # be indistinguishable from a real one. A heredoc rather than a pipe so the
  # loop stays in this shell and its `rc` survives.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # A symlink's staged blob is its target path, not a script, and `bash -n`
    # on a bare path exits 0. Checking one would report success without ever
    # reading what it points at, so say so instead of passing it silently.
    case "$(git ls-files --cached -s -- "$f" | cut -d' ' -f1)" in
      120000)
        echo "  skipped $f: staged as a symlink, so its content is a path, not a script." >&2
        continue
        ;;
    esac
    mkdir -p "$tmp/$(dirname "$f")"
    # Fail closed. A staged path git cannot read is a reason to stop, not a
    # reason to skip the file and still report success.
    if ! git show ":$f" > "$tmp/$f" 2>/dev/null; then
      echo "  could not read staged content for $f" >&2
      rc=1
      continue
    fi
    bash -n "$tmp/$f" || rc=1
    if command -v shellcheck >/dev/null 2>&1; then
      # The same ratchets CI enables. A hook running a weaker shellcheck than
      # CI would let a script pass here and fail there, which is the one
      # outcome this guard exists to prevent.
      shellcheck -S style -e SC1091 \
        --enable=deprecate-which \
        --enable=avoid-nullary-conditions \
        --enable=quote-safe-variables \
        "$tmp/$f" || rc=1
    fi
  done <<EOF
$staged
EOF
  if [ "$rc" -ne 0 ]; then
    echo >&2
    echo "  Staged shell scripts did not pass bash -n / shellcheck." >&2
    echo "  Fix them, or commit with --no-verify if you meant it." >&2
    echo >&2
    exit 1
  fi
fi

exit 0
