#!/usr/bin/env bash
# Refuse commits made directly on an integration branch.
#
# Work belongs on a topic branch so it can be reviewed as a pull request.
# Committing to main locally is easy to do by accident and awkward to undo once
# anything is built on top of it.
#
# Install by copying into .git/hooks/ rather than pointing core.hooksPath at
# this directory: a tracked hook only exists in the working tree while a branch
# containing it is checked out, so it would be missing on exactly the branches
# that predate it.
#
# Deliberate exception (a release chore, an emergency fix):
#     git commit --no-verify
set -eu

PROTECTED='main master'

# Empty during a rebase, cherry-pick, or any other detached-HEAD operation,
# which must not be blocked: those commits were already made on a branch.
branch="$(git symbolic-ref --quiet --short HEAD || true)"
[ -n "$branch" ] || exit 0

for protected in $PROTECTED; do
  if [ "$branch" = "$protected" ]; then
    cat >&2 <<MSG

  Refusing to commit directly on '$branch'.

    git switch -c some-branch-name
    git commit ...

  If you really meant it: git commit --no-verify

MSG
    exit 1
  fi
done

# Staged shell scripts get the same two checks CI runs, on the staged content
# rather than the working tree, so a partial `git add -p` cannot pass here and
# fail there. Skipped entirely when shellcheck is absent: this is a guard rail,
# not a control, and it must not block a contributor who has not installed it.
staged="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$|^\.githooks/' || true)"
if [ -n "$staged" ]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  rc=0
  for f in $staged; do
    mkdir -p "$tmp/$(dirname "$f")"
    git show ":$f" > "$tmp/$f" 2>/dev/null || continue
    bash -n "$tmp/$f" || rc=1
    if command -v shellcheck >/dev/null 2>&1; then
      shellcheck -S style -e SC1091 "$tmp/$f" || rc=1
    fi
  done
  if [ "$rc" -ne 0 ]; then
    echo >&2
    echo "  Staged shell scripts did not pass bash -n / shellcheck." >&2
    echo "  Fix them, or commit with --no-verify if you meant it." >&2
    echo >&2
    exit 1
  fi
fi

exit 0
